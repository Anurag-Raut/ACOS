,"type":"integer"},"kind":{"enum":["long_press"],"type":"string"},"selector":{"anyOf":[{"$ref":"#/definitions/Selector"},{"type":"null"}],"description":"Target selector."},"x":{"description":"Explicit x.","format":"int32","type":["integer","null"]},"y":{"description":"Explicit y.","format":"int32","type":["integer","null"]}},"required":["kind"],"type":"object"},{"description":"Swipe/drag between two points.","properties":{"duration_ms":{"default":300,"description":"Gesture duration.","format":"uint64","minimum":0.0,"type":"integer"},"from":{"allOf":[{"$ref":"#/definitions/Point"}],"description":"Start point."},"kind":{"enum":["swipe"],"type":"string"},"to":{"allOf":[{"$ref":"#/definitions/Point"}],"description":"End point."}},"required":["from","kind","to"],"type":"object"},{"description":"Type text, optionally into a selected node first.","properties":{"clear":{"default":false,"description":"Clear the field first.","type":"boolean"},"kind":{"enum":["type"],"type":"string"},"selector":{"anyOf":[{"$ref":"#/definitions/Selector"},{"type":"null"}],"description":"Target node (absent = current focus)."},"text":{"description":"Text to enter.","type":"string"}},"required":["kind","text"],"type":"object"},{"description":"Press a symbolic key.","properties":{"key":{"allOf":[{"$ref":"#/definitions/KeyName"}],"description":"Key name."},"kind":{"enum":["key"],"type":"string"}},"required":["key","kind"],"type":"object"},{"description":"Press Back.","properties":{"kind":{"enum":["back"],"type":"string"}},"required":["kind"],"type":"object"},{"description":"Rotate the display.","properties":{"kind":{"enum":["rotate"],"type":"string"},"orientation":{"allOf":[{"$ref":"#/definitions/Orientation"}],"description":"Requested orientation."}},"required":["kind","orientation"],"type":"object"},{"description":"Wait for a selector (event-driven, not a polling sleep).","properties":{"kind":{"enum":["wait"],"type":"string"},"selector":{"allOf":[{"$ref":"#/definitions/Selector"}],"description":"Selector to wait for."},"timeout_ms":{"default":5000,"description":"Event-driven timeout.","format":"uint64","minimum":0.0,"type":"integer"}},"required":["kind","selector"],"type":"object"}]},"Bounds":{"description":"Integer screen bounds `[left, top, right, bottom]` in pixels.\n\nSerialized as a four-element array. `right`/`bottom` are exclusive at the Android/UI-automator pixel-grid level.","items":{"format":"int32","type":"integer"},"maxItems":4,"minItems":4,"type":"array"},"DisplaySpec":{"description":"The display a session renders to.\n\n`none` is headless: capture/observe must return `NO_DISPLAY` instead of silently allocating a surface.","oneOf":[{"description":"No display at all (headless logic/storage tests).","properties":{"mode":{"enum":["none"],"type":"string"}},"required":["mode"],"type":"object"},{"description":"Offscreen software surface with an explicit size and density.","properties":{"density_dpi":{"description":"Density in dots per inch (for example 420).","format":"uint32","minimum":0.0,"type":"integer"},"height":{"description":"Height in pixels.","format":"uint32","minimum":0.0,"type":"integer"},"mode":{"enum":["offscreen"],"type":"string"},"width":{"description":"Width in pixels.","format":"uint32","minimum":0.0,"type":"integer"}},"required":["density_dpi","height","mode","width"],"type":"object"}]},"IsolationLevel":{"description":"How independent a session is from other sessions.\n\nThe levels are ordered from cheapest/weakest to strongest. A claim of data independence is only allowed at `sandbox` and above, and only when the engine actually implements the guarantees (see `docs/AGENT_API.md`).","oneOf":[{"description":"Another activity/task in a shared process and shared app data. No isolation.","enum":["shared-task"],"type":"string"},{"description":"Separate process, potentially the same package/storage identity.","enum":["process"],"type":"string"},{"description":"Separate process/UID/credentials/mount namespace and app data.","enum":["sandbox"],"type":"string"},{"description":"Fully separate engine instance (strongest short of a VM).","enum":["core"],"type":"string"},{"description":"Sandboxed full Android/backend for untrusted or device-level fidelity.","enum":["vm"],"type":"string"}]},"KeyName":{"description":"A symbolic key.","oneOf":[{"description":"Back.","enum":["back"],"type":"string"},{"description":"Home.","enum":["home"],"type":"string"},{"description":"Enter.","enum":["enter"],"type":"string"},{"description":"Tab.","enum":["tab"],"type":"string"},{"description":"Delete/backspace.","enum":["delete"],"type":"string"},{"description":"Escape.","enum":["escape"],"type":"string"},{"description":"Volume up.","enum":["volume_up"],"type":"string"},{"description":"Volume down.","enum":["volume_down"],"type":"string"},{"description":"Power.","enum":["power"],"type":"string"},{"description":"Menu.","enum":["menu"],"type":"string"},{"description":"D-pad up.","enum":["dpad_up"],"type":"string"},{"description":"D-pad down.","enum":["dpad_down"],"type":"string"},{"description":"D-pad left.","enum":["dpad_left"],"type":"string"},{"description":"D-pad right.","enum":["dpad_right"],"type":"string"}]},"Orientation":{"description":"Screen orientation.","oneOf":[{"description":"Portrait.","enum":["portrait"],"type":"string"},{"description":"Landscape.","enum":["landscape"],"type":"string"}]},"Point":{"description":"A point in screen pixels.","properties":{"x":{"description":"X coordinate.","format":"int32","type":"integer"},"y":{"description":"Y coordinate.","format":"int32","type":"integer"}},"required":["x","y"],"type":"object"},"RequestBase":{"description":"Identity fields present on every request.","properties":{"budget":{"anyOf":[{"$ref":"#/definitions/ResourceBudget"},{"type":"null"}],"description":"Hard resource budget."},"capabilities":{"description":"Capabilities the request needs.","items":{"type":"string"},"type":"array"},"cause_id":{"description":"The cause of the last known frame, when relevant.","type":["string","null"]},"display":{"anyOf":[{"$ref":"#/definitions/DisplaySpec"},{"type":"null"}],"description":"Requested display (for `run`; reported everywhere)."},"frame_seq":{"description":"The last frame sequence the client has seen, when relevant.","format":"uint64","minimum":0.0,"type":["integer","null"]},"isolation":{"anyOf":[{"$ref":"#/definitions/IsolationLevel"},{"type":"null"}],"description":"Requested isolation level (for `run`/`verify`; reported everywhere)."},"request_id":{"description":"Client-chosen request id, echoed in the envelope and used as the frame `cause_id` for actions that produce a frame.","type":"string"},"session_id":{"description":"Session the request targets (absent for session-creating commands).","type":["string","null"]}},"required":["request_id"],"type":"object"},"ResourceBudget":{"description":"Hard resource budgets for one request or one scenario.\n\nEvery field is opt-in; `None` means \"use the engine default\". The engine must return `RESOURCE_LIMIT`/`TIMEOUT` when a budget is exhausted instead of silently exceeding it.","properties":{"cpu_ms":{"description":"Maximum CPU time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]},"memory_mib":{"description":"Maximum resident memory attributable to this request/session, in MiB.","format":"uint64","minimum":0.0,"type":["integer","null"]},"wall_ms":{"description":"Maximum wall-clock time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]}},"type":"object"},"Selector":{"description":"A node selector. See the module docs for the stable matching rules.","properties":{"bounds":{"anyOf":[{"$ref":"#/definitions/Bounds"},{"type":"null"}],"description":"Exact screen bounds."},"class":{"description":"Exact view class.","type":["string","null"]},"content_desc":{"anyOf":[{"$ref":"#/definitions/TextMatch"},{"type":"null"}],"description":"Content-description matcher."},"hint":{"anyOf":[{"$ref":"#/definitions/TextMatch"},{"type":"null"}],"description":"Hint matcher (`TextView.getHint()`, e.g. an EditText placeholder)."},"id":{"description":"Android resource id (`pkg:id/name`), or a bare local id (`name`).","type":["string","null"]},"include_invisible":{"description":"Also match nodes that are not visible to the user.\n\nDefault `false`: a selector matches only nodes the user can see (`UiNode::visible`, which follows `View.isVisibleToUser()`: shown, and its clipped visible rect non-empty). A warm-mounted page parked off screen is present in the tree but is not a selector match, so `wait_for`/`assert_text`/`assert_visible`/`tap` can never silently act on invisible content. Set it to `true` only for a deliberate check of an off-screen/invisible node (`assert_not_visible`, `assert_state {visible: false}`, diagnostics).","type":"boolean"},"index":{"description":"Zero-based occurrence among otherwise matching nodes.","format":"uint","minimum":0.0,"type":["integer","null"]},"text":{"anyOf":[{"$ref":"#/definitions/TextMatch"},{"type":"null"}],"description":"Text matcher."}},"type":"object"},"TextMatch":{"description":"A text matching rule: exactly one of `exact`, `contains`, `regex`.\n\nA struct rather than an enum so the agent-facing YAML/JSON form is a plain map (`text: {exact: \"Greet\"}`) and not a YAML `!tag`.","properties":{"contains":{"description":"Substring containment.","type":["string","null"]},"exact":{"description":"Full string equality (no trimming or normalisation).","type":["string","null"]},"regex":{"description":"Unanchored Rust regex (`is_match`).","type":["string","null"]}},"type":"object"}},"description":"`action`: deliver one input action.","properties":{"action":{"allOf":[{"$ref":"#/definitions/Action"}],"description":"The action."},"base":{"allOf":[{"$ref":"#/definitions/RequestBase"}],"description":"Identity fields."}},"required":["action","base"],"title":"ActionRequest","type":"object"},"name":"acos_action","title":"acos action"},{"_meta":{"acos":{"available":true,"command":"reset","fidelity":"native-runtime","reason":null,"tool":"acos_reset"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"acos reset"},"description":"Reset task/app/data/all state for a session and report what was actually reset. `state_reset:false` is possible for shared-task isolation (data is shared). Common errors: SESSION_NOT_FOUND, ISOLATION_UNSATISFIED.\n\n[MCP: available=true fidelity=native-runtime command=reset]","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"definitions":{"DisplaySpec":{"description":"The display a session renders to.\n\n`none` is headless: capture/observe must return `NO_DISPLAY` instead of silently allocating a surface.","oneOf":[{"description":"No display at all (headless logic/storage tests).","properties":{"mode":{"enum":["none"],"type":"string"}},"required":["mode"],"type":"object"},{"description":"Offscreen software surface with an explicit size and density.","properties":{"density_dpi":{"description":"Density in dots per inch (for example 420).","format":"uint32","minimum":0.0,"type":"integer"},"height":{"description":"Height in pixels.","format":"uint32","minimum":0.0,"type":"integer"},"mode":{"enum":["offscreen"],"type":"string"},"width":{"description":"Width in pixels.","format":"uint32","minimum":0.0,"type":"integer"}},"required":["density_dpi","height","mode","width"],"type":"object"}]},"IsolationLevel":{"description":"How independent a session is from other sessions.\n\nThe levels are ordered from cheapest/weakest to strongest. A claim of data independence is only allowed at `sandbox` and above, and only when the engine actually implements the guarantees (see `docs/AGENT_API.md`).","oneOf":[{"description":"Another activity/task in a shared process and shared app data. No isolation.","enum":["shared-task"],"type":"string"},{"description":"Separate process, potentially the same package/storage identity.","enum":["process"],"type":"string"},{"description":"Separate process/UID/credentials/mount namespace and app data.","enum":["sandbox"],"type":"string"},{"description":"Fully separate engine instance (strongest short of a VM).","enum":["core"],"type":"string"},{"description":"Sandboxed full Android/backend for untrusted or device-level fidelity.","enum":["vm"],"type":"string"}]},"RequestBase":{"description":"Identity fields present on every request.","properties":{"budget":{"anyOf":[{"$ref":"#/definitions/ResourceBudget"},{"type":"null"}],"description":"Hard resource budget."},"capabilities":{"description":"Capabilities the request needs.","items":{"type":"string"},"type":"array"},"cause_id":{"description":"The cause of the last known frame, when relevant.","type":["string","null"]},"display":{"anyOf":[{"$ref":"#/definitions/DisplaySpec"},{"type":"null"}],"description":"Requested display (for `run`; reported everywhere)."},"frame_seq":{"description":"The last frame sequence the client has seen, when relevant.","format":"uint64","minimum":0.0,"type":["integer","null"]},"isolation":{"anyOf":[{"$ref":"#/definitions/IsolationLevel"},{"type":"null"}],"description":"Requested isolation level (for `run`/`verify`; reported everywhere)."},"request_id":{"description":"Client-chosen request id, echoed in the envelope and used as the frame `cause_id` for actions that produce a frame.","type":"string"},"session_id":{"description":"Session the request targets (absent for session-creating commands).","type":["string","null"]}},"required":["request_id"],"type":"object"},"ResetScope":{"description":"What a reset clears.","oneOf":[{"description":"Recreate the task only; app data is shared.","enum":["task"],"type":"string"},{"description":"Clear app data and relaunch.","enum":["app"],"type":"string"},{"description":"Clear app data and caches.","enum":["data"],"type":"string"},{"description":"Reset everything the session owns.","enum":["all"],"type":"string"}]},"ResourceBudget":{"description":"Hard resource budgets for one request or one scenario.\n\nEvery field is opt-in; `None` means \"use the engine default\". The engine must return `RESOURCE_LIMIT`/`TIMEOUT` when a budget is exhausted instead of silently exceeding it.","properties":{"cpu_ms":{"description":"Maximum CPU time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]},"memory_mib":{"description":"Maximum resident memory attributable to this request/session, in MiB.","format":"uint64","minimum":0.0,"type":["integer","null"]},"wall_ms":{"description":"Maximum wall-clock time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]}},"type":"object"}},"description":"`reset`: reset session/app/data state.","properties":{"base":{"allOf":[{"$ref":"#/definitions/RequestBase"}],"description":"Identity fields."},"scope":{"allOf":[{"$ref":"#/definitions/ResetScope"}],"description":"What to reset."},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"}},"required":["base","scope"],"title":"ResetRequest","type":"object"},"name":"acos_reset","title":"acos reset"},{"_meta":{"acos":{"available":true,"command":"destroy","fidelity":"native-runtime","reason":null,"tool":"acos_destroy"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"acos destroy"},"description":"Tear down a session and release its worker/display. Idempotent: destroying an absent session reports already_absent. After destroy, the session_id is invalid for every other command.\n\n[MCP: available=true fidelity=native-runtime command=destroy]","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"definitions":{"DisplaySpec":{"description":"The display a session renders to.\n\n`none` is headless: capture/observe must return `NO_DISPLAY` instead of silently allocating a surface.","oneOf":[{"description":"No display at all (headless logic/storage tests).","properties":{"mode":{"enum":["none"],"type":"string"}},"required":["mode"],"type":"object"},{"description":"Offscreen software surface with an explicit size and density.","properties":{"density_dpi":{"description":"Density in dots per inch (for example 420).","format":"uint32","minimum":0.0,"type":"integer"},"height":{"description":"Height in pixels.","format":"uint32","minimum":0.0,"type":"integer"},"mode":{"enum":["offscreen"],"type":"string"},"width":{"description":"Width in pixels.","format":"uint32","minimum":0.0,"type":"integer"}},"required":["density_dpi","height","mode","width"],"type":"object"}]},"IsolationLevel":{"description":"How independent a session is from other sessions.\n\nThe levels are ordered from cheapest/weakest to strongest. A claim of data independence is only allowed at `sandbox` and above, and only when the engine actually implements the guarantees (see `docs/AGENT_API.md`).","oneOf":[{"description":"Another activity/task in a shared process and shared app data. No isolation.","enum":["shared-task"],"type":"string"},{"description":"Separate process, potentially the same package/storage identity.","enum":["process"],"type":"string"},{"description":"Separate process/UID/credentials/mount namespace and app data.","enum":["sandbox"],"type":"string"},{"description":"Fully separate engine instance (strongest short of a VM).","enum":["core"],"type":"string"},{"description":"Sandboxed full Android/backend for untrusted or device-level fidelity.","enum":["vm"],"type":"string"}]},"RequestBase":{"description":"Identity fields present on every request.","properties":{"budget":{"anyOf":[{"$ref":"#/definitions/ResourceBudget"},{"type":"null"}],"description":"Hard resource budget."},"capabilities":{"description":"Capabilities the request needs.","items":{"type":"string"},"type":"array"},"cause_id":{"description":"The cause of the last known frame, when relevant.","type":["string","null"]},"display":{"anyOf":[{"$ref":"#/definitions/DisplaySpec"},{"type":"null"}],"description":"Requested display (for `run`; reported everywhere)."},"frame_seq":{"description":"The last frame sequence the client has seen, when relevant.","format":"uint64","minimum":0.0,"type":["integer","null"]},"isolation":{"anyOf":[{"$ref":"#/definitions/IsolationLevel"},{"type":"null"}],"description":"Requested isolation level (for `run`/`verify`; reported everywhere)."},"request_id":{"description":"Client-chosen request id, echoed in the envelope and used as the frame `cause_id` for actions that produce a frame.","type":"string"},"session_id":{"description":"Session the request targets (absent for session-creating commands).","type":["string","null"]}},"required":["request_id"],"type":"object"},"ResourceBudget":{"description":"Hard resource budgets for one request or one scenario.\n\nEvery field is opt-in; `None` means \"use the engine default\". The engine must return `RESOURCE_LIMIT`/`TIMEOUT` when a budget is exhausted instead of silently exceeding it.","properties":{"cpu_ms":{"description":"Maximum CPU time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]},"memory_mib":{"description":"Maximum resident memory attributable to this request/session, in MiB.","format":"uint64","minimum":0.0,"type":["integer","null"]},"wall_ms":{"description":"Maximum wall-clock time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]}},"type":"object"}},"description":"`destroy`: tear down a session.","properties":{"base":{"allOf":[{"$ref":"#/definitions/RequestBase"}],"description":"Identity fields."},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"}},"required":["base"],"title":"DestroyRequest","type":"object"},"name":"acos_destroy","title":"acos destroy"},{"_meta":{"acos":{"available":true,"command":"verify","fidelity":"native-runtime","reason":null,"tool":"acos_verify"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"acos verify"},"description":"Run an APK + YAML scenario and write a complete artifacts directory (run.json, verdict.json, steps/, frames/, tree/, events.jsonl, resources.json, repro.*). This is the primary verification loop: inspect -> verify -> read verdict.json -> fix -> rerun. A pass is valid only if its evidence exists; `unsupported` is never a pass. Set required_fidelity when the task needs ART/device evidence. A run owns its artifacts directory: a non-empty `artifacts` directory written by another run is refused with INVALID_ARGUMENT naming that run (details.previous_run_id) unless `overwrite: true`. Settle semantics (REL3A): every step JSON states the settle rule it used and its outcome (`settle: {mode, settled, waited_ms, reason}`). `wait_for` and the tree/text assertions default to auto (strict, then the content-stable rule when the screen animates forever in pixels) and honour `timeout_ms`; a step whose settle timed out is never a pass (`status: timeout`, error class infra_timeout). `animations` (on/off) and `native` are the same options `acos verify` has. Common errors: INVALID_ARGUMENT, INVALID_SCENARIO, ARTIFACTS_INVALID, ASSERTION_FAILED, APP_CRASHED, TIMEOUT, UNSUPPORTED_*, UNVERIFIED_FIDELITY.\n\n[MCP: available=true fidelity=native-runtime command=verify]","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"definitions":{"DisplaySpec":{"description":"The display a session renders to.\n\n`none` is headless: capture/observe must return `NO_DISPLAY` instead of silently allocating a surface.","oneOf":[{"description":"No display at all (headless logic/storage tests).","properties":{"mode":{"enum":["none"],"type":"string"}},"required":["mode"],"type":"object"},{"description":"Offscreen software surface with an explicit size and density.","properties":{"density_dpi":{"description":"Density in dots per inch (for example 420).","format":"uint32","minimum":0.0,"type":"integer"},"height":{"description":"Height in pixels.","format":"uint32","minimum":0.0,"type":"integer"},"mode":{"enum":["offscreen"],"type":"string"},"width":{"description":"Width in pixels.","format":"uint32","minimum":0.0,"type":"integer"}},"required":["density_dpi","height","mode","width"],"type":"object"}]},"Fidelity":{"description":"How faithful the execution behind a result is.\n\n* `static-analysis` — host parsing only. Proves nothing about runtime behaviour. * `jvm-reference` — host OpenJDK. Proves pure-Java semantics only; never Android/ART/framework/JNI/rendering behaviour. * `native-runtime` — executed by ACOS itself (its Rust VM/loader/renderer). This is **not** validated against ART unless `validated_against` says so. * `art-reference` — real ART on a reference Android image. Authoritative for Android framework behaviour at the stated API/ABI. * `physical-device` — a real device/OEM target. * `simulated` — a mock/stub path. A simulated success is not an Android success. * `n/a` — a **meta** reply: a tool that reports on ACOS itself (`acos_help`, `acos_capabilities`, `acos_doctor`). It says nothing about app behaviour, so labelling it `static-analysis` would imply the reply was derived from the APK. `n/a` never satisfies a fidelity requirement and is never a pass.","oneOf":[{"description":"Static host analysis only.","enum":["static-analysis"],"type":"string"},{"description":"Host JVM (weak oracle; never Android-verified).","enum":["jvm-reference"],"type":"string"},{"description":"ACOS native execution; not ART-validated by itself.","enum":["native-runtime"],"type":"string"},{"description":"Real ART reference capture/execution.","enum":["art-reference"],"type":"string"},{"description":"Physical device/OEM target.","enum":["physical-device"],"type":"string"},{"description":"Mocked/simulated behaviour.","enum":["simulated"],"type":"string"},{"description":"Not applicable: a meta reply about ACOS itself (help/capabilities/doctor).","enum":["n/a"],"type":"string"}]},"IsolationLevel":{"description":"How independent a session is from other sessions.\n\nThe levels are ordered from cheapest/weakest to strongest. A claim of data independence is only allowed at `sandbox` and above, and only when the engine actually implements the guarantees (see `docs/AGENT_API.md`).","oneOf":[{"description":"Another activity/task in a shared process and shared app data. No isolation.","enum":["shared-task"],"type":"string"},{"description":"Separate process, potentially the same package/storage identity.","enum":["process"],"type":"string"},{"description":"Separate process/UID/credentials/mount namespace and app data.","enum":["sandbox"],"type":"string"},{"description":"Fully separate engine instance (strongest short of a VM).","enum":["core"],"type":"string"},{"description":"Sandboxed full Android/backend for untrusted or device-level fidelity.","enum":["vm"],"type":"string"}]},"RequestBase":{"description":"Identity fields present on every request.","properties":{"budget":{"anyOf":[{"$ref":"#/definitions/ResourceBudget"},{"type":"null"}],"description":"Hard resource budget."},"capabilities":{"description":"Capabilities the request needs.","items":{"type":"string"},"type":"array"},"cause_id":{"description":"The cause of the last known frame, when relevant.","type":["string","null"]},"display":{"anyOf":[{"$ref":"#/definitions/DisplaySpec"},{"type":"null"}],"description":"Requested display (for `run`; reported everywhere)."},"frame_seq":{"description":"The last frame sequence the client has seen, when relevant.","format":"uint64","minimum":0.0,"type":["integer","null"]},"isolation":{"anyOf":[{"$ref":"#/definitions/IsolationLevel"},{"type":"null"}],"description":"Requested isolation level (for `run`/`verify`; reported everywhere)."},"request_id":{"description":"Client-chosen request id, echoed in the envelope and used as the frame `cause_id` for actions that produce a frame.","type":"string"},"session_id":{"description":"Session the request targets (absent for session-creating commands).","type":["string","null"]}},"required":["request_id"],"type":"object"},"ResourceBudget":{"description":"Hard resource budgets for one request or one scenario.\n\nEvery field is opt-in; `None` means \"use the engine default\". The engine must return `RESOURCE_LIMIT`/`TIMEOUT` when a budget is exhausted instead of silently exceeding it.","properties":{"cpu_ms":{"description":"Maximum CPU time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]},"memory_mib":{"description":"Maximum resident memory attributable to this request/session, in MiB.","format":"uint64","minimum":0.0,"type":["integer","null"]},"wall_ms":{"description":"Maximum wall-clock time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]}},"type":"object"},"VerifyEngine":{"description":"The execution engine `verify` runs on.\n\nOne vocabulary, three front doors: `art` (real ART, or recorded ART evidence with `--reference`) and `rust-vm` (the frozen Rust VM) are the words the `--engine` flag, this schema and the scenario YAML `engine:` field all use.\n\nThe scenario field records the engine a scenario was *written for*; it does not select one — the request's `engine` (CLI `--engine`, MCP `engine`) stays authoritative, and a disagreement is reported as `SCENARIO_ENGINE_MISMATCH` in the verdict's `provenance.warnings[]` rather than silently changing the engine. The pre-v0.3 spellings are accepted as aliases (`native-preferred`/`native-only` -> `rust-vm`, `reference-only` -> `art`) with a warning that names the current word.","oneOf":[{"description":"Real Google ART through an `acos-art` guest (the default).","enum":["art"],"type":"string"},{"description":"The frozen Rust VM / native runtime (diagnostics; never silently chosen).","enum":["rust-vm"],"type":"string"}]}},"description":"`verify`: run an APK + scenario and produce artifacts.","properties":{"animations":{"description":"REL3A: framework animation scales for the ART session (`on`/`off`).\n\nThe same option `acos verify --animations` has. `off` sets Android's three animation scales to 0 for functional checks; it is never for animation/transition testing, and it cannot make an app that animates in its own code (React Native `Animated`, a custom `ValueAnimator`) stop - use a `settle: content` step for that. Overrides a scenario's top-level `animations`. Launch-time only; the Rust VM has no framework animators and refuses `off`.","type":["string","null"]},"apk":{"description":"APK path (overrides the scenario `app` when set).","type":["string","null"]},"artifacts":{"description":"Artifacts output directory.\n\nA run owns its directory: a non-empty directory written by another run is refused with `INVALID_ARGUMENT` naming the previous run id, unless [`VerifyRequest::overwrite`] is set.","type":"string"},"base":{"allOf":[{"$ref":"#/definitions/RequestBase"}],"description":"Identity fields."},"cursor":{"description":"REL3C: compact-screen page cursor from a previous reply's `tree_next_cursor`.","minimum":0,"type":"integer"},"engine":{"allOf":[{"$ref":"#/definitions/VerifyEngine"}],"default":"art","description":"Execution engine: `art` (the default: real ART) or `rust-vm` (the frozen Rust VM).\n\nThe default is `art`, qualified by one rule: a request that sets `reference` and omits `engine` replays recorded ART evidence with the `rust-vm` side, because `--reference` is replay, not live ART execution. An explicit `engine: art` together with `reference` is refused (`INVALID_ARGUMENT`), never silently reinterpreted."},"flags":{"default":[],"description":"Deterministic `NAME=VALUE` flags recorded in the reproducer (`repro.json`'s `flags` and the `--flag` lines of `repro.sh`).\n\nA flag is metadata, not a command-line option: it must be `NAME=VALUE` with a name matching `[A-Za-z][A-Za-z0-9_.-]*` and a non-empty value, so a value can never be read as another option. A malformed flag is `INVALID_ARGUMENT` (`details.index` names it).","items":{"type":"string"},"type":"array"},"full":{"description":"REL3C: include the full tree inline instead of the compact screen (default false). The full tree is always written to `tree_path`; a full tree over the reply cap is replaced by the compact view and the path.","type":"boolean"},"native":{"default":false,"description":"REL3A: enable the APK's `lib/<abi>/` natives under confinement (the same option `acos verify --native` has). The confinement is entered before the session worker (and therefore before guest code) starts.","type":"boolean"},"overwrite":{"default":false,"description":"Replace artifacts left by another run in `artifacts` (`--overwrite`).\n\nOff by default: two runs never interleave evidence in one directory, so a stale frame can never be mistaken for this run's.","type":"boolean"},"reference":{"description":"Optional art-reference directory to compare against.","type":["string","null"]},"required_fidelity":{"anyOf":[{"$ref":"#/definitions/Fidelity"},{"type":"null"}],"description":"Minimum fidelity the verdict must achieve."},"scenario":{"description":"Scenario path.","type":"string"}},"required":["artifacts","base","scenario"],"title":"VerifyRequest","type":"object"},"name":"acos_verify","title":"acos verify"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"n/a","reason":null,"tool":"acos_capabilities"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"n/a","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_capabilities"},"description":"Report what the ACOS backend can do right now: which ACOS commands are implemented, the resolved `acos` binary/version, and the server's limits. Call it when a tool returns `unsupported` or when the available set may have changed; pass `refresh: true` to re-probe the backend after a rebuild.\n\n[MCP: available=true fidelity=n/a]","inputSchema":{"additionalProperties":false,"properties":{"refresh":{"description":"Re-run the backend capability probe before answering.","type":"boolean"}},"type":"object"},"name":"acos_capabilities","title":"acos_capabilities"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"n/a","reason":null,"tool":"acos_help"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"n/a","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_help"},"description":"The ACOS agent guide. With no `topic` this returns a SHORT skeleton: the three status rules, the loop in ten lines, and the topic list with one-line descriptions. Call it before your first ACOS call, then ask for one section by name: `mcp` (every advertised MCP tool: required/optional args, one example call, what it returns — generated from the tool descriptors), `workflow` (the loop plus the screenshot/type/content_desc/prove-a-flow recipes), `cli` (every command with a runnable example), `scenarios` (writing a verify YAML), `errors` (code -> action), `limits` (one support row per route for native Views, React Native and Flutter; API 34, x86_64, rotation, memory admission). `topic: \"all\"` returns the complete guide; an unknown topic returns the skeleton again.\n\n[MCP: available=true fidelity=n/a]","inputSchema":{"additionalProperties":false,"properties":{"topic":{"description":"Optional section of the guide: `overview` (the default skeleton), \n`workflow` (the loop), `cli` (commands + examples), `scenarios` (verify YAML), `errors` \n(codes -> action), `limits` (what is not supported), `all` (the whole guide).","enum":["overview","mcp","workflow","cli","scenarios","errors","limits","all"],"type":"string"}},"type":"object"},"name":"acos_help","title":"acos_help"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_launch"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_launch"},"description":"Call this FIRST for an app you want to drive: it boots the APK in an in-process session that persists across MCP calls (the CLI relaunches per invocation). Returns the honest launch stage ladder (apk_parsed -> process_booted -> bind_application -> application_on_create -> client_transaction -> activity_on_create -> on_resume -> first_frame) plus `session_id`, `reached_stage` and `classes_loaded`. `ok:true` is only returned when every rung ran; otherwise the first blocked rung carries the structured blocker with a code and `details`. Re-launching the same session id replaces the previous task. Common errors: APK_*, WRONG_ABI, CONFINEMENT_UNAVAILABLE (native), TIMEOUT, RESOURCE_LIMIT, UNSUPPORTED_JAVA_API/UNSUPPORTED_ANDROID_API (a framework native the engine does not implement yet, naming `details.api`).\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"animations":{"description":"P12: per-session framework animation scales. `on` (default) is real Android behaviour. `off` sets the three animation scales to 0 (standard CI practice) so functional checks are not slowed by the framework's ~0.9 s press/elevation animator; never use it for animation/transition testing. Launch-time only: every reply states `animations`.","enum":["on","off"],"type":"string"},"apk":{"description":"Path to the .apk, under ACOS_ALLOWED_ROOTS.","type":"string"},"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"cursor":{"description":"Compact-screen page cursor from a previous reply's `tree_next_cursor`.","minimum":0,"type":"integer"},"display":{"description":"Display override for the in-process session, `WIDTHxHEIGHT@DPI` (for example `1080x2400@400`). This argument is accepted by the in-process engine; the ART daemon route reports the display it used instead of overriding it.","type":"string"},"flutter":{"description":"Declare this APK a Flutter app: forces the native (confined child) route even before the structural check sees libflutter.so/flutter_assets, and picks the Flutter engine session when the APK really is Flutter. Detection is otherwise structural, never a manifest guess; the reply's `engine` says which engine actually ran.","type":"boolean"},"full":{"description":"Include the full tree inline instead of the compact screen (default false). The full tree is always written to `tree_path`; a full tree that would exceed the reply cap is replaced by the compact view and the path.","type":"boolean"},"idle_ttl_s":{"description":"FB5: seconds of idleness before this server destroys the session (default 600 = 10 min, or ACOS_SESSION_IDLE_TTL_S; `0` disables). Any later MCP call on the session renews the clock. An expired session's guest is gone and the next call returns SESSION_NOT_FOUND with `details.reason=idle_ttl_expired` and the TTL, so a parked session fails loudly instead of eating memory.","minimum":0,"type":"integer"},"label":{"description":"FB5: a name for this session, echoed in the launch reply and in `acos_status` (`sessions[].label`). Give each session you park a label you can recognise — the server destroys its own idle sessions, and the label is how you tell which one went.","type":"string"},"native":{"description":"Run the APK's lib/<abi>/*.so under the ADR-0022 confinement. The multi-threaded MCP server re-execs a fresh, single-threaded child session process that enters the sandbox before launching; later observe/action calls are proxied to that confined child.","type":"boolean"},"pixels":{"description":"Capture a PNG for the launch reply (default false). Without it the reply carries the bound C1 frame identity (`buffer_generation`, `frame_number`) and no md5; `settle:fast` and `settle:content`                                     refuse pixels (a content-settled frame is tree-content evidence                                     only; its pixels may still be animating).","type":"boolean"},"rn":{"description":"Declare this APK a React Native app: forces the native (confined child) route and picks the React Native bridge session when the APK really is RN. Detection is otherwise structural (libreactnativejni.so / index.android.bundle); the reply's `engine` says which engine actually ran.","type":"boolean"},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"settle":{"description":"How the launch reply binds its tree. `strict` (default) keeps the 150 ms quiet window and is assertion evidence. `fast` binds the app's first traversal from a fresh in-guest probe sample with no quiet window; it may be mid-animation and is never assertion evidence. `content` (SE2) is the content-stable rule for a screen that animates forever: settled when the UI tree content signature is unchanged for a >=300 ms window across >=2 traversals; it backs UI/text observations only, never pixels. The reply's `settle` object names the mode and how it was bound.","enum":["fast","strict","content"],"type":"string"},"settle_timeout_ms":{"description":"P12: bound the strict/fast settle wait. On timeout the reply still carries the latest tree and frame identity with `settled:false` and `bound:timeout`; a timeout is never assertion evidence.","maximum":600000,"minimum":1,"type":"integer"},"timeout_ms":{"description":"Wall-clock ceiling for the launch (defaults to the server call budget).","minimum":1,"type":"integer"}},"type":"object"},"name":"acos_launch","title":"acos_launch"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_observe_tree"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_observe_tree"},"description":"Walk the live framework View hierarchy of the held session (WindowManagerGlobal -> ViewRootImpl -> ViewGroup) and return a COMPACT screen by default: the visible text/content_desc nodes in reading order with bounds, clickable flag and ids, paged with `cursor` (never head/tail-cut). The full tree is always written to `tree_path`; `full:true` returns it inline when it fits the reply cap. Call it after `acos_launch`, before any selector-based tap. Before the app adds a window it returns `UNSUPPORTED_BACKEND` with `details.reason=not_ready` and `details.stage_reached`, never an empty tree. Common errors: UNSUPPORTED_BACKEND (not_ready), TIMEOUT.\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"cursor":{"description":"Compact-screen page cursor from a previous reply's `tree_next_cursor`.","minimum":0,"type":"integer"},"full":{"description":"Include the full tree inline instead of the compact screen (default false). The full tree is always written to `tree_path`; a full tree that would exceed the reply cap is replaced by the compact view and the path.","type":"boolean"},"max_nodes":{"description":"Truncate the walk after this many nodes.","minimum":1,"type":"integer"},"screenshot":{"description":"FB2: `true` writes this frame's lossless PNG under the session's artifacts and returns `screenshot.path` (absolute), `width`, `height`, `display_size`, `display_origin` and `frame_seq`, plus a bounded inline preview in this reply. A string writes to that path instead. A placeholder/no-pixel frame answers NO_FRESH_FRAME, never an empty success. `display_origin` is the offset between PNG pixels and tree bounds: png_y = display_y - display_origin.y.","type":["boolean","string"]},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"settle":{"description":"`strict` (default) is the event-settled rule and assertion evidence. `fast` binds the newest probe sample immediately (may be mid-animation; not assertion evidence). `content` (SE2) proves the tree content stable for a >=300 ms window and is the documented answer for a screen that animates forever in pixels.","enum":["fast","strict","content"],"type":"string"},"settle_timeout_ms":{"description":"P12: bound the strict settle wait. On timeout the tree is still returned with `settled:false` and `bound:timeout`.","maximum":600000,"minimum":1,"type":"integer"}},"type":"object"},"name":"acos_observe_tree","title":"acos_observe_tree"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_tap"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_tap"},"description":"Tap in the held session. Identify the target by `id` (a node whose `resource_id` equals it, or its bare local name after `/`, exactly what `acos_observe_tree` exposes), by `content_desc` (a node's accessibility label — what a React Native pressable carries its whole name in, e.g. \"Search Japanese dictionary\"), by `text` (the platform's *accessible name*: the node's text, else its content description among nodes the user can see), by a React Native `testID` (resolves to the nearest clickable ancestor), or by a point `x`,`y` (both required). Precedence is `id`, then `content_desc`, then `text`, then `testID`, then `x`/`y`. A selector that matches more than one user-visible node is refused as `AMBIGUOUS_SELECTOR` with every candidate (`id`, `text`, `content_desc`, `bounds`) — narrow it or pass `index`; nothing is tapped silently. Requires `acos_observe_tree` first for selector taps. Returns action/accepted/input_ack_seq plus `changes`, the settled tree diff of the tap (`added`/`removed`/`changed` nodes, current activity, focused node) so the next step usually needs no `acos_observe_tree`; `diff:false` turns it off. Common errors: AMBIGUOUS_SELECTOR (several matches), ELEMENT_NOT_FOUND with `details.kind=NoSuchNode`/`NoUiTree` (observe first), ELEMENT_OFFSCREEN (only an invisible node matches), TIMEOUT. A React Native session has no View tree and no pixel frame, so point taps are unsupported there.\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"content_desc":{"description":"Node `content_desc` to tap (exact). Prefer it for React Native `accessibilityLabel`s; takes precedence over `text`.","type":"string"},"diff":{"description":"FB3: include `changes`, the settled UI-tree diff of this action (added/removed/changed nodes with `id`/`text`/`content_desc`/ `class`/`bounds`; a changed node also lists which `fields` changed, old -> new; plus the current activity and the focused node). Computed from trees the session already holds, so it costs no extra traversal and no extra guest round trip. Default `true`; `false` returns the pre-FB3 reply byte for byte. Each list is capped at 40 entries with `truncated:true` and the true `counts`; `changes.baseline:\"none\"` means the session held no pre-action tree (no diff is invented).","type":"boolean"},"expect_change":{"description":"SE1: opt-in verification of the action's effect. After the strict settle, fail the action (ASSERTION_FAILED, `details.reason=\"expect_change\"`, `pixels_changed:false`, before/after frame refs) when the settled frame's pixels are identical to the pre-action frame. Use it on a tap/type/key whose point is to change the screen; `settle:fast` with `expect_change:true` is rejected (a fast frame is never assertion evidence), and a reply with no measured `pixels_changed` is UNSUPPORTED_ASSERTION, never a pass.","type":"boolean"},"id":{"description":"Node `resource_id` (or bare local name) to tap; takes precedence over content_desc/text and x/y.","type":"string"},"index":{"description":"Pick the Nth match of the other fields, document order. Use it only when the same label is legitimately repeated.","minimum":0,"type":"integer"},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"settle":{"description":"`fast` for navigation (may be mid-animation); `strict` (default) is the event-settled rule; `content` (SE2) is the content-stable rule for a screen that animates forever in pixels (tree content proven stable >=300 ms; never pixel evidence).","enum":["fast","strict","content"],"type":"string"},"settle_timeout_ms":{"description":"P12: bound the settle wait. On timeout the reply still carries the latest tree and frame identity with `settled:false`, `bound:timeout`.","maximum":600000,"minimum":1,"type":"integer"},"testID":{"description":"React Native testID to tap (resolves to the nearest clickable ancestor); used when `id` and `text` are absent.","type":"string"},"text":{"description":"Node label to tap: the platform's accessible name (text, else content description) among visible nodes.","type":"string"},"x":{"description":"X coordinate for a point tap (requires `y`).","type":"integer"},"y":{"description":"Y coordinate for a point tap (requires `x`).","type":"integer"}},"type":"object"},"name":"acos_tap","title":"acos_tap"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_key"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_key"},"description":"Press a key in the held session. `code` is an Android key code (4=BACK, 66=ENTER, 3=HOME) or a name (`back`, `home`, `enter`, `menu`, `tab`, `escape`, `delete`). Returns `changes` (the settled tree diff of the key) by default. Common errors: ELEMENT_NOT_FOUND with `details.kind=NoFocusedWindow` (launch/observe first).\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"code":{"description":"Numeric key code or name.","type":["integer","string"]},"diff":{"description":"FB3: include `changes`, the settled UI-tree diff of this action (added/removed/changed nodes with `id`/`text`/`content_desc`/ `class`/`bounds`; a changed node also lists which `fields` changed, old -> new; plus the current activity and the focused node). Computed from trees the session already holds, so it costs no extra traversal and no extra guest round trip. Default `true`; `false` returns the pre-FB3 reply byte for byte. Each list is capped at 40 entries with `truncated:true` and the true `counts`; `changes.baseline:\"none\"` means the session held no pre-action tree (no diff is invented).","type":"boolean"},"expect_change":{"description":"SE1: opt-in verification of the action's effect. After the strict settle, fail the action (ASSERTION_FAILED, `details.reason=\"expect_change\"`, `pixels_changed:false`, before/after frame refs) when the settled frame's pixels are identical to the pre-action frame. Use it on a tap/type/key whose point is to change the screen; `settle:fast` with `expect_change:true` is rejected (a fast frame is never assertion evidence), and a reply with no measured `pixels_changed` is UNSUPPORTED_ASSERTION, never a pass.","type":"boolean"},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"settle_timeout_ms":{"description":"P12b: bound this verb's strict/fast settle wait. On timeout the reply still carries the latest tree and frame identity with `settled:false` and `bound:timeout`; a timeout is never assertion evidence.","maximum":600000,"minimum":1,"type":"integer"}},"type":"object"},"name":"acos_key","title":"acos_key"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_text"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_text"},"description":"Type `text` into the session's focused editor — the same path a scenario `type` step takes: the guest's own `type_text` command drives the focused text field (real `InputConnection.commitText`/virtual-keyboard path), so `TextWatcher`s, the selection and the cursor update as on a device. There is no need for the node's class to be `EditText`: React Native `TextInput`s are obfuscated subclasses, so a field you focused by `content_desc` accepts text. Focus the field first (observe, then `acos_tap`), then type. The reply's `result.target.node` is the field the input went to, as the tree shows it (the focused node). The typed text is echoed only for a focused non-password field; otherwise it is masked (`target.text_masked = true`, `chars` only, `reason`): a password field, `mask: true`, or an unknown target (the tree names no focused field -- nothing is guessed). Common errors: UNSUPPORTED_BACKEND when a character cannot be represented on the key-event fallback, TIMEOUT when the screen never settles. Composing text and IME actions are not modelled. Returns `changes` (the settled tree diff of the typing) by default; `diff:false` turns it off.\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"diff":{"description":"FB3: include `changes`, the settled UI-tree diff of this action (added/removed/changed nodes with `id`/`text`/`content_desc`/ `class`/`bounds`; a changed node also lists which `fields` changed, old -> new; plus the current activity and the focused node). Computed from trees the session already holds, so it costs no extra traversal and no extra guest round trip. Default `true`; `false` returns the pre-FB3 reply byte for byte. Each list is capped at 40 entries with `truncated:true` and the true `counts`; `changes.baseline:\"none\"` means the session held no pre-action tree (no diff is invented).","type":"boolean"},"expect_change":{"description":"SE1: opt-in verification of the action's effect. After the strict settle, fail the action (ASSERTION_FAILED, `details.reason=\"expect_change\"`, `pixels_changed:false`, before/after frame refs) when the settled frame's pixels are identical to the pre-action frame. Use it on a tap/type/key whose point is to change the screen; `settle:fast` with `expect_change:true` is rejected (a fast frame is never assertion evidence), and a reply with no measured `pixels_changed` is UNSUPPORTED_ASSERTION, never a pass.","type":"boolean"},"mask":{"description":"Withhold the typed text from the reply (`target.text_masked`, `target.chars`). Use it for a secret whose field the tree does not report as focused. Without it, a focused non-password field is echoed and any other target is masked.","type":"boolean"},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"settle_timeout_ms":{"description":"P12b: bound this verb's strict/fast settle wait. On timeout the reply still carries the latest tree and frame identity with `settled:false` and `bound:timeout`; a timeout is never assertion evidence.","maximum":600000,"minimum":1,"type":"integer"},"text":{"description":"Text to type into the focused field.","type":"string"}},"type":"object"},"name":"acos_text","title":"acos_text"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_swipe"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_swipe"},"description":"Swipe/scroll in the held session: `from`+`to` points (objects with integer `x` and `y`), or `direction` (`up`/`down`/`left`/`right`) plus an optional `distance` in pixels (default 60% of the display along that axis). The ART engine publishes a real interpolated MotionEvent stream (DOWN, MOVEs at the display refresh cadence with real timestamps, UP) through the same input channel a tap uses, so a ListView/RecyclerView/ RN FlatList flings with its own physics; `duration_ms` defaults to 400 (120 when `fling: true`). `handled` is the window's own `finishInputEvent` bit per event (REL3E), and `changes` is the settled tree diff (FB3).\n\n`until` (a selector object, e.g. `{\"text\": \"Row 80\"}`) turns the call into a bounded `scroll_until` search: it swipes, takes a fresh **settled** traversal and repeats up to `max_attempts` (default 6, 10 with `fling`). `until.found` is only ever reported from such a traversal; a miss is ELEMENT_NOT_FOUND with `details.attempts` and `details.last_tree_texts`.\n\nCommon errors: ELEMENT_NOT_FOUND `details.kind=NoWindowAtPoint` (no frame yet), INVALID_ARGUMENT (missing point/direction, or `until` with a non-strict settle).\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"diff":{"description":"FB3: include `changes`, the settled UI-tree diff of this action (added/removed/changed nodes with `id`/`text`/`content_desc`/ `class`/`bounds`; a changed node also lists which `fields` changed, old -> new; plus the current activity and the focused node). Computed from trees the session already holds, so it costs no extra traversal and no extra guest round trip. Default `true`; `false` returns the pre-FB3 reply byte for byte. Each list is capped at 40 entries with `truncated:true` and the true `counts`; `changes.baseline:\"none\"` means the session held no pre-action tree (no diff is invented).","type":"boolean"},"direction":{"description":"Direction-based gesture used when `from`/`to` are absent: `up` moves the finger up, i.e. the content scrolls up and later rows come into view.","enum":["up","down","left","right"],"type":"string"},"distance":{"description":"Direction-based gesture length in pixels (default 60% of the display along the direction's axis).","type":"integer"},"duration_ms":{"minimum":1,"type":"integer"},"fling":{"description":"A fast gesture (short duration, high velocity) instead of a slow drag. The list's own fling physics decide how far it coasts.","type":"boolean"},"from":{"properties":{"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y"],"type":"object"},"max_attempts":{"description":"Bound for an `until` search (1..50; default 6, or 10 with `fling`).","type":"integer"},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"to":{"properties":{"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y"],"type":"object"},"until":{"description":"Selector to scroll into view (`id`/`content_desc`/`text`); the call repeats the swipe up to `max_attempts` and reports `until.found` only from a settled observation.","type":"object"}},"type":"object"},"name":"acos_swipe","title":"acos_swipe"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_logs"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_logs"},"description":"Read the guest log buffer of the held session. By DEFAULT it returns the agent-relevant view: records at priority `W` and above plus anything that names the app's own package, so framework/SoLoader noise does not bury the app's words. Optional `tag` (substring, case-insensitive), `min_priority` (`V`/`D`/`I`/`W`/`E`/`F` or `2`..=`7`, default `W`) and `all: true` (no defaults at all: the whole buffer) filter the records. The unfiltered buffer stays on disk (`logs/logcat.txt` in a verify run), and `min_priority: \"V\"` returns it. Consecutive identical records are collapsed: each carries `repeat_count` and its `line` gains a `(repeated N times)` suffix. Returns `total`, `count`, `collapsed`, `filter` (the defaults that were applied) plus `launched` and `stage_reached`. An empty buffer is a valid pass, but is only meaningful once the app reached `onCreate`; check `stage_reached` before concluding the run was clean. It never fabricates lifecycle lines.\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"all":{"description":"Return the whole buffer with no default priority/package filter (the same view as `min_priority: \"V\"`).","type":"boolean"},"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"min_priority":{"description":"Minimum logcat priority (`V`/`D`/`I`/`W`/`E`/`F` or 2..7). Defaults to `W`.","type":["string","integer"]},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"},"tag":{"description":"Keep only records whose tag contains this substring.","type":"string"}},"type":"object"},"name":"acos_logs","title":"acos_logs"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"native-runtime","reason":null,"tool":"acos_status"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"native-runtime","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_status"},"description":"Report whether the held session has launched, the last launch stage reached, and the published frame count. Use it to tell 'app never started' from 'app started but no window/frame yet' before reading logs or observing. Also lists **this server's** sessions under `sessions[]` (FB5): `session_id`, `label`, `package`, `activity`, `age_s`, `idle_s`, the applicable `idle_ttl_s`, the guest's `guest_pid` and `guest_rss_kb`, and `live`. Use it to find and clean up every session you left behind — the server also reclaims its own after the idle TTL.\n\n[MCP: available=true fidelity=native-runtime]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"},"session_id":{"description":"Session to address, the same value as `base.session_id` (the documented short form: `acos_observe_tree {\"session_id\": \"mcp-1234\", \"screenshot\": true}`). Omit it for this server process's default session.","type":"string"}},"type":"object"},"name":"acos_status","title":"acos_status"},{"_meta":{"acos":{"available":true,"command":null,"fidelity":"n/a","reason":null,"tool":"acos_doctor"}},"annotations":{"available":true,"destructiveHint":false,"fidelity":"n/a","idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"acos_doctor"},"description":"Run the host preflight (`acos doctor`) and return its JSON report. Call it FIRST when a build or launch fails before the app runs: it checks the Android SDK/build-tools, `android.jar`, the JDK (`java`/`javac`/`keytool`), the workspace helper and debug keystore, the boot-classpath cache, and host memory. Each failing check carries a concrete `fix` string. The tool returns `fail` with `ASSERTION_FAILED` when any required check fails, with the full report under `result.checks`.\n\n[MCP: available=true fidelity=n/a]","inputSchema":{"additionalProperties":false,"properties":{"base":{"description":"Identity fields; only `session_id` is meaningful here.","properties":{"request_id":{"type":"string"},"session_id":{"type":"string"}},"type":"object"}},"type":"object"},"name":"acos_doctor","title":"acos_doctor"}]}}
