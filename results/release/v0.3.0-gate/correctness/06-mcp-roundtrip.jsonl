n relevant.","type":["string","null"]},"display":{"anyOf":[{"$ref":"#/definitions/DisplaySpec"},{"type":"null"}],"description":"Requested display (for `run`; reported everywhere)."},"frame_seq":{"description":"The last frame sequence the client has seen, when relevant.","format":"uint64","minimum":0.0,"type":["integer","null"]},"isolation":{"anyOf":[{"$ref":"#/definitions/IsolationLevel"},{"type":"null"}],"description":"Requested isolation level (for `run`/`verify`; reported everywhere)."},"request_id":{"description":"Client-chosen request id, echoed in the envelope and used as the frame `cause_id` for actions that produce a frame.","type":"string"},"session_id":{"description":"Session the request targets (absent for session-creating commands).","type":["string","null"]}},"required":["request_id"],"type":"object"},"ResourceBudget":{"description":"Hard resource budgets for one request or one scenario.\n\nEvery field is opt-in; `None` means \"use the engine default\". The engine must return `RESOURCE_LIMIT`/`TIMEOUT` when a budget is exhausted instead of silently exceeding it.","properties":{"cpu_ms":{"description":"Maximum CPU time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]},"memory_mib":{"description":"Maximum resident memory attributable to this request/session, in MiB.","format":"uint64","minimum":0.0,"type":["integer","null"]},"wall_ms":{"description":"Maximum wall-clock time, in milliseconds.","format":"uint64","minimum":0.0,"type":["integer","null"]}},"type":"object"}},"description":"`run`: launch an app and create a session.","properties":{"activity":{"description":"Activity component (`pkg/.Activity` or `.Activity`).","type":["string","null"]},"apk":{"description":"APK path.","type":"string"},"base":{"allOf":[{"$ref":"#/definitions/RequestBase"}],"description":"Identity fields; `isolation` and `display` are honoured here."},"data":{"description":"Intent data URI.","type":["string","null"]},"data_policy":{"anyOf":[{"$ref":"#/d