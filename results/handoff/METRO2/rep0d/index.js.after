/**
 * ACOS React Native "hello" fixture (RN 0.81.4, Hermes, legacy/Paper arch).
 *
 * Deliberately JSX-free so the bundle inputs are plain JavaScript: the only
 * transform Metro has to perform is the CommonJS/module graph. The component
 * renders the minimal Text + Button surface ACOS must reproduce.
 *
 * @format
 */
'use strict';
// METRO2b diagnostics (scratch only)
(function () {
  const RN = require('react-native');
  const t0 = Date.now();
  const log = (m) => console.log('M2B ' + (Date.now() - t0) + 'ms ' + m);
  const AR = RN.AppRegistry;
  const o = AR.unmountApplicationComponentAtRootTag;
  AR.unmountApplicationComponentAtRootTag = function (tag) {
    log('unmount start tag=' + tag);
    try { return o.apply(this, arguments); } finally { log('unmount done tag=' + tag); }
  };
  const UM = RN.UIManager;
  for (const k of ['removeRootView', 'removeSubviewsFromContainerWithID']) {
    const f = UM[k];
    if (f) UM[k] = function () { log('UIManager.' + k + ' ' + JSON.stringify(Array.from(arguments)).slice(0, 80)); return f.apply(this, arguments); };
  }
  log('context start');
})();

const React = require('react');
const {
  AppRegistry,
  Button,
  StyleSheet,
  Text,
  View,
} = require('react-native');

function RnHello() {
  const [count, setCount] = React.useState(0);
  return React.createElement(
    View,
    { style: styles.container, testID: 'hello-root' },
    React.createElement(Text, { style: styles.title, testID: 'hello-text' }, 'Hello Metro (reloaded)'),
    React.createElement(Text, { style: styles.subtitle }, 'React Native + Hermes'),
    React.createElement(
      Button,
      {
        title: 'Tap me',
        testID: 'hello-button',
        onPress: () => setCount((c) => c + 1),
      },
    ),
    React.createElement(Text, { style: styles.count, testID: 'count-text' }, 'count: ' + count),
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, alignItems: 'center', justifyContent: 'center' },
  title: { fontSize: 24, fontWeight: 'bold' },
  subtitle: { fontSize: 14, marginTop: 4, marginBottom: 12 },
  count: { fontSize: 16, marginTop: 12 },
});

AppRegistry.registerComponent('rnhello', () => RnHello);
