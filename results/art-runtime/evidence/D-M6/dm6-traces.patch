-    eprintln!("acos-art: stage {name} exec={}ms", exec_elapsed_ms());
+    let exec_ms = exec_elapsed_ms();
+    eprintln!("acos-art: stage {name} exec={exec_ms}ms");
+    // D-M6 (trace-only, env-gated): the same marker in a file the caller can
+    // read. `acos serve` drains the launcher's stderr into an 8 KiB in-memory
+    // tail, so a stage table cannot be reconstructed from stderr; this sink
+    // records it verbatim with the host wall clock (so a stage can be aligned
+    // with the spawning process's own clock) and this process's pid (so
+    // several launches appending to one file stay separable). Inert unless
+    // `DM6_ART_STAGE_TRACE` names a file; no reply or control flow changes.
+    if let Some(path) = std::env::var_os("DM6_ART_STAGE_TRACE") {
+        use std::io::Write;
+        let unix_ms = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_millis() as u64)
+            .unwrap_or(0);
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+        {
+            let _ = writeln!(
+                file,
+                "DM6STAGE pid={} unix_ms={unix_ms} name={name} exec={exec_ms}ms",
+                std::process::id()
+            );
+        }
+    }
 }
 
