+/// D-M6 (trace-only, env-gated): append one JSON line describing a host-side
+/// reset phase. Off unless `DM6_RESET_TRACE` names a file. Never changes a
+/// reply, an error or a control-flow decision.
+fn reset_trace(event: serde_json::Value) {
+    if let Some(path) = std::env::var_os("DM6_RESET_TRACE") {
+        use std::io::Write;
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+        {
+            let _ = writeln!(file, "{event}");
+        }
+    }
+}
+
+/// Host wall clock in Unix milliseconds (0 when the clock is unreadable).
+fn unix_ms_now() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
