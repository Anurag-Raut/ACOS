 /// FNV-1a over the pixels plus the count of pixels with any non-zero byte.
+/// D-M5 (trace-only, `surface_client.rs` patch used in a throwaway worktree):
+/// microseconds on the realtime clock so a C1 sub-phase lines up with the
+/// serve/launcher trace. Inert unless `DM5_TRACE` names a file.
+fn dm5_trace(event: &str, dur_us: u128, extra: &str) {
+    use std::io::Write;
+    static SINK: std::sync::OnceLock<Option<std::sync::Mutex<std::fs::File>>> =
+        std::sync::OnceLock::new();
+    let sink = SINK.get_or_init(|| {
+        std::env::var_os("DM5_TRACE")
+            .and_then(|path| {
+                std::fs::OpenOptions::new()
+                    .create(true)
+                    .append(true)
+                    .open(path)
+                    .ok()
+            })
+            .map(std::sync::Mutex::new)
+    });
+    if let Some(file) = sink {
+        if let Ok(mut file) = file.lock() {
+            let t_us = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_micros())
+                .unwrap_or(0);
+            let _ = writeln!(
+                file,
+                "DM5TRACE proc=c1 ev={event} t_us={t_us} dur_us={dur_us} {extra}"
+            );
+            let _ = file.flush();
+        }
+    }
+}
