new file mode 100644
index 0000000..6fecaef
--- /dev/null
+++ b/crates/acos-sandbox/src/live.rs
@@ -0,0 +1,137 @@
+//! Fork-and-confine live probe, used by `acos sandbox-probe`.
+//!
+//! Forks a child that applies the profile and reports the resulting layer
+//! statuses back over a pipe. The parent is never confined, so the probe can
+//! run inside a normal process. This is safe to call while single-threaded;
+//! callers that are already multi-threaded should rely on the static
+//! [`probe`](crate::probe) instead.
+
+use std::os::raw::{c_int, c_void};
+
+use serde::{Deserialize, Serialize};
+
+use crate::confine::{confine, ConfinementReport};
+use crate::error::ConfineError;
+use crate::ConfineProfile;
+
+#[derive(Serialize, Deserialize)]
+enum LiveOutcome {
+    Report(ConfinementReport),
+    Error { code: String, message: String },
+}
+
+/// Apply `profile` in a forked child and return the child's report.
+///
+/// The child's `keep_fds` is extended with the report pipe so fd hygiene in
+/// the child cannot sever the report channel.
+pub fn probe_live(profile: &ConfineProfile) -> Result<ConfinementReport, ConfineError> {
+    let mut fds = [0 as c_int; 2];
+    // SAFETY: `fds` is a valid two-element out-parameter array.
+    let rc = unsafe { libc::pipe(fds.as_mut_ptr()) };
+    if rc != 0 {
+        return Err(unavailable(format!(
+            "pipe: {}",
+            std::io::Error::last_os_error()
+        )));
+    }
+    let (read_fd, write_fd) = (fds[0], fds[1]);
+
+    // SAFETY: `fork` has no arguments. The child runs a bounded code path and
+    // terminates with `_exit`; it never returns into the parent's stack.
+    let pid = unsafe { libc::fork() };
+    if pid < 0 {
+        // SAFETY: both descriptors are live and owned here.
+        unsafe {
+            libc::close(read_fd);
+            libc::close(write_fd);
+        }
+        return Err(unavailable(format!(
+            "fork: {}",
+            std::io::Error::last_os_error()
+        )));
+    }
+    if pid == 0 {
+        // Child: report through the pipe, then leave immediately.
+        // SAFETY: the read end is not needed in the child.
+        unsafe {
+            libc::close(read_fd);
+        }
+        let mut child_profile = profile.clone();
+        if !child_profile.keep_fds.contains(&write_fd) {
+            child_profile.keep_fds.push(write_fd);
+        }
+        let outcome = match confine(&child_profile) {
+            Ok(report) => LiveOutcome::Report(report),
+            Err(e) => LiveOutcome::Error {
+                code: e.code().to_string(),
+                message: e.to_string(),
+            },
+        };
+        let payload = serde_json::to_vec(&outcome).unwrap_or_default();
+        write_all(write_fd, &payload);
+        // SAFETY: `_exit` terminates without running destructors or atexit.
+        unsafe {
+            libc::_exit(0);
+        }
+    }
+
+    // Parent.
+    // SAFETY: the write end is closed in the parent; the child owns its copy.
+    unsafe {
+        libc::close(write_fd);
+    }
+    let payload = read_all(read_fd);
+    // SAFETY: `read_fd` is live.
+    unsafe {
+        libc::close(read_fd);
+    }
+    let mut status: c_int = 0;
+    // SAFETY: `pid` is a live child and `status` is a valid out-parameter.
+    unsafe {
+        libc::waitpid(pid, &mut status, 0);
+    }
+
+    match serde_json::from_slice::<LiveOutcome>(&payload) {
+        Ok(LiveOutcome::Report(report)) => Ok(report),
+        Ok(LiveOutcome::Error { code, message }) => Err(ConfineError::Unavailable {
+            missing: Vec::new(),
+            message: format!("{code}: {message}"),
+        }),
+        Err(e) => Err(unavailable(format!(
+            "invalid live probe output: {e} ({})",
+            String::from_utf8_lossy(&payload)
+        ))),
+    }
+}
+
+fn unavailable(message: String) -> ConfineError {
+    ConfineError::Unavailable {
+        missing: Vec::new(),
+        message,
+    }
+}
+
+fn write_all(fd: c_int, mut buf: &[u8]) {
+    while !buf.is_empty() {
+        // SAFETY: `buf` is a valid slice and `fd` is a live descriptor.
+        let n = unsafe { libc::write(fd, buf.as_ptr() as *const c_void, buf.len()) };
+        if n <= 0 {
+            break;
+        }
+        buf = &buf[n as usize..];
+    }
+}
+
+fn read_all(fd: c_int) -> Vec<u8> {
+    let mut out = Vec::new();
+    let mut chunk = [0u8; 4096];
+    loop {
+        // SAFETY: `chunk` is a valid mutable buffer and `fd` is live.
+        let n = unsafe { libc::read(fd, chunk.as_mut_ptr() as *mut c_void, chunk.len()) };
+        if n <= 0 {
+            break;
+        }
+        out.extend_from_slice(&chunk[..n as usize]);
+    }
+    out
+}
diff --git a/crates/acos-sandbox/src/probe.rs b/crates/acos-sandbox/src/probe.rs
new file mode 100644
index 0000000..2fc078f
--- /dev/null
+++ b/crates/acos-sandbox/src/probe.rs
@@ -0,0 +1,82 @@
+//! Unprivileged capability probe: what can this host actually support.
+//!
+//! Every field is derived from read-only kernel interfaces
+//! (`/proc/sys`, `/sys/fs/cgroup`) or a version syscall. Nothing here changes
+//! process state, so it is safe to call before a decision to confine.
+
+use serde::{Deserialize, Serialize};
+
+use crate::linux;
+
+/// What the running kernel/host can support, independent of any profile.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Capabilities {
+    /// `uname -r`.
+    pub kernel_release: String,
+    /// `std::env::consts::ARCH` (e.g. `x86_64`).
+    pub arch: String,
+    /// Landlock ABI version, or `None` when Landlock is unavailable.
+    pub landlock_abi: Option<u32>,
+    /// Whether the kernel exposes the seccomp-bpf interface.
+    pub seccomp: bool,
+    /// Whether unprivileged user namespaces can be created.
+    pub unprivileged_userns: bool,
+    /// Whether a cgroup-v2 hierarchy is mounted.
+    pub cgroup_v2: bool,
+}
+
+/// Probe the host. Does not modify the process.
+pub fn probe() -> Capabilities {
+    Capabilities {
+        kernel_release: kernel_release(),
+        arch: std::env::consts::ARCH.to_string(),
+        landlock_abi: linux::landlock_abi(),
+        seccomp: seccomp_available(),
+        unprivileged_userns: unprivileged_userns_available(),
+        cgroup_v2: std::path::Path::new("/sys/fs/cgroup/cgroup.controllers").exists(),
+    }
+}
+
+fn kernel_release() -> String {
+    std::fs::read_to_string("/proc/sys/kernel/osrelease")
+        .map(|s| s.trim().to_string())
+        .unwrap_or_else(|_| std::env::consts::OS.to_string())
+}
+
+fn seccomp_available() -> bool {
+    // `actions_avail` exists on every kernel that supports seccomp filters;
+    // the directory itself is the fallback for older exports.
+    std::path::Path::new("/proc/sys/kernel/seccomp/actions_avail").exists()
+        || std::path::Path::new("/proc/sys/kernel/seccomp").is_dir()
+}
+
+fn unprivileged_userns_available() -> bool {
+    // The `unprivileged_userns_clone` knob (Debian/Ubuntu) gates it explicitly.
+    if let Ok(value) = std::fs::read_to_string("/proc/sys/kernel/unprivileged_userns_clone") {
+        if value.trim() == "0" {
+            return false;
+        }
+    }
+    // `max_user_namespaces` is the upstream knob: 0 disables unprivileged
+    // creation.
+    match std::fs::read_to_string("/proc/sys/user/max_user_namespaces") {
+        Ok(value) => value.trim().parse::<u64>().map(|n| n > 0).unwrap_or(true),
+        Err(_) => true,
+    }
+}
+
+/// Probe whether a transient systemd user scope (`systemd-run --user --scope`)
+/// can be created for optional cgroup-v2 memory/PID limits.
+///
+/// This *does* spawn a helper process, so it is deliberately not part of
+/// [`probe`]; it is reported by `acos sandbox-probe` and is never required.
+pub fn systemd_user_scope_available() -> bool {
+    std::process::Command::new("systemd-run")
+        .args(["--user", "--scope", "-q", "true"])
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .map(|s| s.success())
+        .unwrap_or(false)
+}
