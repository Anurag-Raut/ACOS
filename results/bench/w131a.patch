+            ));
+        }
+        let mode = meta.permissions().mode() & 0o777;
         if mode & 0o077 != 0 {
-            // The cache is private; tighten a pre-existing directory.
+            // The cache is private; tighten a pre-existing directory, then
+            // verify the change stuck.
