<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.acos.fixtures.keystoreprobe"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- K5b: the AndroidKeyStore fidelity + cross-session probe. One launcher
         activity; the mode comes from ACOS_ART_KEYPROBE_MODE so a single APK
         serves every arm (fidelity / create / probe / default_off) and no
         activity selection is needed on the launch path. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:debuggable="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
