<?xml version="1.0" encoding="utf-8"?>
<!--
  REL3E fixture: the shape that made "input reported as sent" ambiguous.

  Row `row` is a plain (not clickable) LinearLayout whose title TextView
  (`title`) is a label and whose Switch (`toggle`) is the only clickable thing
  in the row - exactly a React Native settings row where the row title is not
  the pressable and the switch is. A tap on `title` therefore reaches a
  non-clickable TextView whose whole ancestor chain is not clickable either, so
  the app window answers `finishInputEvent(handled) = false`.

  The `inc` Button is clickable and increments `count`, the control that proves
  a handled tap really did change state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/row_title"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/row_switch" />
    </LinearLayout>

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/state_off" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/inc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inc" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/initial" />
    </LinearLayout>
</LinearLayout>
