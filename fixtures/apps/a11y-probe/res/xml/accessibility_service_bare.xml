<?xml version="1.0" encoding="utf-8"?>
<!--
  MODA11Y6 step 2, the negative case: a second declared service with the
  block present but the capability absent. It must get exactly the AOSP
  answer — `getWindows` null (the framework turns that into an empty list),
  node queries null, actions false — never the window list and never an
  exception.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100" />
