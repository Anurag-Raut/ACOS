<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/idle" />

    <TextView
        android:id="@+id/draws"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="draws=0" />

    <!-- A real draw: onDraw() logs, so a background-thread postInvalidate()
         is observable as a frame even when no text changes. -->
    <dev.acos.fixtures.looperwake.PulseView
        android:id="@+id/pulse"
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <Button
        android:id="@+id/go"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go" />

    <Button
        android:id="@+id/invalidate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/invalidate" />
</LinearLayout>
