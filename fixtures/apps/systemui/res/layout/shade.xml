<?xml version="1.0" encoding="utf-8"?>
<!--
  The shade: a title, one row per posted notification (title + text, the row is
  the tap target) and an empty-state label. Ids are stable so an agent can tap
  `shade_row_0` from the served tree; a session posts at most three rows (a
  shade longer than that is not what this fixture is for).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/shade_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:text="@string/shade_title" />

    <TextView
        android:id="@+id/shade_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textSize="16sp"
        android:visibility="gone"
        android:text="@string/shade_empty" />

    <TextView
        android:id="@+id/shade_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textSize="16sp"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone" />

    <TextView
        android:id="@+id/shade_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="16sp"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone" />

    <TextView
        android:id="@+id/shade_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="16sp"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone" />
</LinearLayout>
