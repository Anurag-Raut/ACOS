<?xml version="1.0" encoding="utf-8"?>
<!--
  MPROC4 step 3b/3c: the SECOND app process.

  `dev.acos.fixtures.procb` is installed as an extra APK in proc-a's session; it
  is started lazily (never at launch) when proc-a's `startActivityForResult`
  resolves to `ProcBActivity`, and its service runs in this same process. Its
  identity is what the process list and the cross-process binder routing must
  name.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.acos.fixtures.procb"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:name=".ProcBApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:debuggable="true">
        <activity
            android:name=".ProcBActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProcBPickActivity"
            android:exported="false" />
        <service
            android:name=".EchoService"
            android:exported="true" />
    </application>
</manifest>
