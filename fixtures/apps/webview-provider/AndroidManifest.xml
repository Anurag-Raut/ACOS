<?xml version="1.0" encoding="utf-8"?>
<!--
  ADR-0031: the ACOS WebView provider package. The framework loads a provider
  from an *installed system package* (`WebViewFactory.getWebViewContextAndSetProvider`
  -> `PackageManager.getPackageInfo` -> `Application.createApplicationContext`
  -> `Class.forName("com.android.webview.chromium.WebViewChromiumFactoryProviderForT")`),
  so the package is an ordinary APK that the session installs like any other
  extra package; nothing in it is special to the framework except the package
  name and the class name it looks up by hand.

  The `com.android.webview.WebViewLibrary` meta-data is **required** by the
  API-34 framework, not optional: `WebViewFactory.verifyPackageInfo` refuses a
  provider whose `ApplicationInfo.metaData` does not carry the key
  (`getWebViewLibrary(ai) == null` -> "Tried to load an invalid WebView
  provider"; image `classes4.dex`, `WebViewFactory.verifyPackageInfo` offset
  0x18..0x1e, `getWebViewLibrary` reads the string key
  `com.android.webview.WebViewLibrary`). It is declared here for that reason.

  Loading it is a different question, and AOSP's own answer for a process that
  did not reserve address space in the zygote is to load nothing:
  `WebViewLibraryLoader.loadNativeLibrary` starts with
  `if (!sAddressSpaceReserved) { Log.e(..., "can't load with relro file; address
  space not reserved"); return LIBLOAD_ADDRESS_SPACE_NOT_RESERVED; }` (image
  `classes4.dex`, offset 0x0..0xc), and `WebViewFactory.getProviderClass`
  discards the return value. ACOS's guest process is not the zygote and never
  calls `WebViewFactory.prepareWebViewInZygote`, so the provider is pure Java
  (it drives the host's pinned Chromium over the broker socket) and no `.so` is
  shipped or loaded: the declaration is the framework's provider-validity bit,
  the load is the framework's honest no-op for this process.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.webview"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:hasCode="true"
        android:label="Android System WebView"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="com.android.webview.WebViewLibrary"
            android:value="libwebviewchromium.so" />
    </application>
</manifest>
