      "id": "def_session_body",
      "type": "text",
      "x": 717,
      "y": 123,
      "width": 631,
      "height": 34,
      "text": "One isolated virtual Android device (you can run N = 1..20+ concurrently on 1 Host).\nACOS's per-session Rust process is the 'Session Controller' (NOT a 2nd Host machine!).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One isolated virtual Android device (you can run N = 1..20+ concurrently on 1 Host).\nACOS's per-session Rust process is the 'Session Controller' (NOT a 2nd Host machine!).",
      "autoResize": true,
      "lineHeight": 1.25
    },
