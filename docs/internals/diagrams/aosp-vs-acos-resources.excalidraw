      "width": 596,
      "height": 18,
      "text": "RAM Formula for N Parallel Sessions on 1 Host",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RAM Formula for N Parallel Sessions on 1 Host",
      "autoResize": true,
