      "id": "acos_core_body",
      "type": "text",
      "x": 1084,
      "y": 717,
      "width": 276,
      "height": 101,
      "text": "Replaces system_server + SurfaceFlinger:\n• ServiceHost (acos-services):\n  AMS, ATMS, PMS, Settings, Display\n• Window Manager + Compositor:\n  acos-wm + AOSP acos-sfgeom\n• Offscreen software frames + a11y\n  (budget: 16 MiB | actual ~4.5 MiB)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Replaces system_server + SurfaceFlinger:\n• ServiceHost (acos-services):\n  AMS, ATMS, PMS, Settings, Display\n• Window Manager + Compositor:\n  acos-wm + AOSP acos-sfgeom\n• Offscreen software frames + a11y\n  (budget: 16 MiB | actual ~4.5 MiB)",
      "autoResize": true,
      "lineHeight": 1.25
    },
