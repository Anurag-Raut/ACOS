      "roundness": null,
      "seed": 1049234620,
      "version": 1,
      "versionNonce": 1498032823,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795149935429,
      "link": null,
      "locked": false,
      "id": "sum_formula_body",
      "type": "text",
      "x": 72,
      "y": 1329,
      "width": 596,
      "height": 109,
      "text": "Stock AOSP Emulator:\n  Total ≈  N × 3,300 MiB   (linear, zero sharing across VMs)\n\nACOS (Exec / Zygote):\n  Total ≈  190 MiB (Host Pool) + N × 37 MiB (or 23 MiB Zygote)\n         + [optional Host once: +26M netd, +135M webview]\n         + [optional per-session modules: +1–4 MiB each]",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stock AOSP Emulator:\n  Total ≈  N × 3,300 MiB   (linear, zero sharing across VMs)\n\nACOS (Exec / Zygote):\n  Total ≈  190 MiB (Host Pool) + N × 37 MiB (or 23 MiB Zygote)\n         + [optional Host once: +26M netd, +135M webview]\n         + [optional per-session modules: +1–4 MiB each]",
      "autoResize": true,
      "lineHeight": 1.25
    },
