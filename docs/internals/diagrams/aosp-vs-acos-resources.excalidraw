      "id": "aosp_warn_title",
      "type": "text",
      "x": 90,
      "y": 1014,
      "width": 576,
      "height": 18,
      "text": "Why Stock Emulators Don't Scale for Parallel AI Agents",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Stock Emulators Don't Scale for Parallel AI Agents",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1500486860,
      "version": 1,
      "versionNonce": 782189299,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795149935429,
      "link": null,
      "locked": false,
      "id": "aosp_warn_body",
      "type": "text",
      "x": 90,
      "y": 1038,
      "width": 576,
      "height": 49,
      "text": "VM #1 and VM #2 share ZERO guest RAM: every parallel agent boots its own Linux kernel,\nits own system_server, its own SurfaceFlinger, its own Zygote, and its own Chromium.\n→ 10 parallel agents = ~32 GiB RAM.   20 parallel agents = ~64.5 GiB (OOM on 61 GiB Host!).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VM #1 and VM #2 share ZERO guest RAM: every parallel agent boots its own Linux kernel,\nits own system_server, its own SurfaceFlinger, its own Zygote, and its own Chromium.\n→ 10 parallel agents = ~32 GiB RAM.   20 parallel agents = ~64.5 GiB (OOM on 61 GiB Host!).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
