      "id": "sum_table_body",
      "type": "text",
      "x": 712,
      "y": 1329,
      "width": 606,
      "height": 94,
      "text": "Sessions (N)   |  Stock Emulator   |  ACOS (Exec)  |  ACOS (Zygote)\n---------------+-------------------+---------------+----------------\nN = 1          |   ~3,300 MiB      |   234 MiB     |   ~215 MiB\nN = 10         |  ~33,000 MiB      |   561 MiB     |    403 MiB\nN = 20         |  ~66,000 MiB OOM! |   935 MiB     |    645 MiB\nCold Launch    |     25.2 sec      |  ~0.15-0.3 s  |   ~0.15 s",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sessions (N)   |  Stock Emulator   |  ACOS (Exec)  |  ACOS (Zygote)\n---------------+-------------------+---------------+----------------\nN = 1          |   ~3,300 MiB      |   234 MiB     |   ~215 MiB\nN = 10         |  ~33,000 MiB      |   561 MiB     |    403 MiB\nN = 20         |  ~66,000 MiB OOM! |   935 MiB     |    645 MiB\nCold Launch    |     25.2 sec      |  ~0.15-0.3 s  |   ~0.15 s",
      "autoResize": true,
      "lineHeight": 1.25
    },
