target/
/fixtures/build/
/results/tmp/
/.cache/
*.class
/results/aidl/all_interfaces.json
# HotSpot dump files: a build-only JVM (javac/d8) that dies writes these into
# its inherited working directory. ACOS now routes them into
# .cache/art/jvm-dumps (`crates/acos-art/src/jvm.rs`); these patterns keep a
# stray one from a hand-run tool out of the repository.
replay_pid*.log
hs_err_pid*.log
core.[0-9]*
/libexec/

# Local/generated, never tracked
__pycache__/
*.pyc
/off/
/research/.cache/

# results/ and out/: only reports (*.md) and the few inputs that code reads are
# tracked. All other run evidence (frames, logs,
# JSON captures, ...) is local-only; see results/README.md. `out/` is the default
# `acos` run-output directory and is never tracked.
/out/
/results/**
!/results/**/
!/results/**/*.md
# New results/ content is one .md report per task (AGENTS.md "What may be committed");
# scripts and run output stay local. Already-tracked harness files are unaffected.
!/results/aidl/**
!/results/wm/**
!/results/res/**
!/results/render/corpus/**
!/results/bench/BASELINE.json
!/results/bench/schema/**
!/results/art-runtime/evidence/W31-artifacts/gaten-release-evidence/**
!/results/parity/w193a/counter.png
!/results/parity/w193a/counter.tree.json
!/results/oracle/dexprogs-nondeterminism.txt
/results/aidl/all_interfaces.json

# Run output never belongs in git, wherever an agent writes it.
repro.sh
/results/**/artifacts/**
*.verdict.json
