+/// ACOS patch (BUILDCACHE): make `SCCACHE_BASEDIRS` mean for Rust what it already
+/// means for C/C++, i.e. "these directories hold interchangeable checkouts of one
+/// tree".
+///
+/// Stock sccache hashes the compile cwd verbatim (the comment at its call site
+/// says it "will wind up in the rlib") and every `CARGO_*` variable verbatim.
+/// Cargo sets the cwd to the workspace root and `CARGO_MANIFEST_DIR` to the
+/// crate's directory, so two worktrees of the same sources never share an entry
+/// even with `SCCACHE_BASEDIRS` set -- the setting is silently a no-op for Rust.
+///
+/// A value below a base directory hashes as `<basedir>` plus its path below that
+/// base directory with one leading component removed. That component is the
+/// interchangeable part: the worktree directory (`.../acos/t3-1a2b`) or, when the
+/// base directory is itself a checkout, nothing at all.
+///
+/// Values that a compile *depends* on (the env-deps rustc records in its
+/// dep-info) are hashed verbatim before this function is reached, so a crate
+/// whose artifact bakes in an absolute path is never served another checkout's
+/// build.
+fn normalized_basedir_value(value: &[u8], basedirs: &[Vec<u8>]) -> Vec<u8> {
+    let mut best: Option<&[u8]> = None;
+    for dir in basedirs {
+        let mut dir = dir.as_slice();
+        while dir.last() == Some(&b'/') {
+            dir = &dir[..dir.len() - 1];
+        }
+        if dir.is_empty() || value.len() < dir.len() || &value[..dir.len()] != dir {
+            continue;
+        }
+        if value.len() != dir.len() && value[dir.len()] != b'/' {
+            continue;
+        }
+        if best.is_none_or(|b| b.len() < dir.len()) {
+            best = Some(dir);
+        }
+    }
+    let Some(dir) = best else {
+        return value.to_vec();
+    };
+    let rest = &value[dir.len()..];
+    // Drop the first component below the base directory (the checkout directory).
+    let rest = if rest.is_empty() {
+        rest
+    } else {
+        let after_first = &rest[1..];
+        match after_first.iter().position(|b| *b == b'/') {
+            Some(i) => &after_first[i..],
+            None => &after_first[..0],
+        }
+    };
+    let mut out = b"<basedir>".to_vec();
+    out.extend_from_slice(rest);
+    out
+}
