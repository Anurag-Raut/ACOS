{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Assertion": {
      "description": "Any assertion the `assert` command can evaluate.",
      "oneOf": [
        {
          "description": "Node text (and optional bounds).",
          "properties": {
            "bounds": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Bounds"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional exact expected screen bounds."
            },
            "kind": {
              "enum": [
                "text"
              ],
              "type": "string"
            },
            "selector": {
              "allOf": [
                {
                  "$ref": "#/definitions/Selector"
                }
              ],
              "description": "Which node to inspect."
            },
            "text": {
              "allOf": [
                {
                  "$ref": "#/definitions/TextMatch"
                }
              ],
              "description": "Expected text matcher."
            },
            "timeout_ms": {
              "description": "Event-driven timeout; the runtime waits for a matching frame/tree, never for a fixed sleep.",
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "selector",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Node visibility.",
          "properties": {
            "bounds": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Bounds"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional exact expected bounds."
            },
            "kind": {
              "enum": [
                "visible"
              ],
              "type": "string"
            },
            "selector": {
              "allOf": [
                {
                  "$ref": "#/definitions/Selector"
                }
              ],
              "description": "Which node to inspect."
            },
            "timeout_ms": {
              "description": "Event-driven timeout.",
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "description": "Node invisibility.",
          "properties": {
            "bounds": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Bounds"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional exact expected bounds."
            },
            "kind": {
              "enum": [
                "not_visible"
              ],
              "type": "string"
            },
            "selector": {
              "allOf": [
                {
                  "$ref": "#/definitions/Selector"
                }
              ],
              "description": "Which node to inspect."
            },
            "timeout_ms": {
              "description": "Event-driven timeout.",
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "description": "Node state flags.",
          "properties": {
            "checked": {
              "description": "Expected checked flag.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "clickable": {
              "description": "Expected clickable flag.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "enabled": {
              "description": "Expected enabled flag.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "focused": {
              "description": "Expected focus flag.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "state"
              ],
              "type": "string"
            },
            "scrollable": {
              "description": "Expected scrollable flag.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "selected": {
              "description": "Expected selected flag (`View.isSelected()`).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "selector": {
              "allOf": [
                {
                  "$ref": "#/definitions/Selector"
                }
              ],
              "description": "Which node to inspect."
            },
            "timeout_ms": {
              "description": "Event-driven timeout.",
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "visible": {
              "description": "Expected visibility.",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "description": "Log line sequence.",
          "properties": {
            "kind": {
              "enum": [
                "log"
              ],
              "type": "string"
            },
            "min_matches": {
              "default": 1,
              "description": "Minimum number of matched lines required per pattern.",
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "ordered": {
              "default": true,
              "description": "Require the patterns in order.",
              "type": "boolean"
            },
            "patterns": {
              "description": "Regex patterns to match against log messages.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "since_previous_step": {
              "default": false,
              "description": "Only consider log events produced since the previous scenario step. This is what makes lifecycle assertions step-scoped instead of matching an earlier cycle.",
              "type": "boolean"
            },
            "tag": {
              "description": "Log tag to filter on (for example `AcosFixture`).",
              "type": [
                "string",
                "null"
              ]
            },
            "timeout_ms": {
              "description": "Event-driven timeout.",
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "patterns"
          ],
          "type": "object"
        },
        {
          "description": "No crash/ANR.",
          "properties": {
            "kind": {
              "enum": [
                "no_crash"
              ],
              "type": "string"
            },
            "since_seq": {
              "description": "Only consider events with `seq > since_seq`.",
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Screenshot regression.",
          "properties": {
            "baseline": {
              "description": "Baseline PNG path, relative to the scenario file or workspace root.",
              "type": "string"
            },
            "kind": {
              "enum": [
                "screenshot"
              ],
              "type": "string"
            },
            "region_masks": {
              "default": [],
              "description": "Regions excluded from the comparison.",
              "items": {
                "$ref": "#/definitions/RegionMask"
              },
              "type": "array"
            },
            "tolerance": {
              "description": "Maximum allowed fraction of changed pixels in `0.0..=1.0`.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "baseline",
            "kind",
            "tolerance"
          ],
          "type": "object"
        }
      ]
    },
    "Bounds": {
      "description": "Integer screen bounds `[left, top, right, bottom]` in pixels.\n\nSerialized as a four-element array. `right`/`bottom` are exclusive at the Android/UI-automator pixel-grid level.",
      "items": {
        "format": "int32",
        "type": "integer"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "DisplaySpec": {
      "description": "The display a session renders to.\n\n`none` is headless: capture/observe must return `NO_DISPLAY` instead of silently allocating a surface.",
      "oneOf": [
        {
          "description": "No display at all (headless logic/storage tests).",
          "properties": {
            "mode": {
              "enum": [
                "none"
              ],
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "description": "Offscreen software surface with an explicit size and density.",
          "properties": {
            "density_dpi": {
              "description": "Density in dots per inch (for example 420).",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "height": {
              "description": "Height in pixels.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "mode": {
              "enum": [
                "offscreen"
              ],
              "type": "string"
            },
            "width": {
              "description": "Width in pixels.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "density_dpi",
            "height",
            "mode",
            "width"
          ],
          "type": "object"
        }
      ]
    },
    "IsolationLevel": {
      "description": "How independent a session is from other sessions.\n\nThe levels are ordered from cheapest/weakest to strongest. A claim of data independence is only allowed at `sandbox` and above, and only when the engine actually implements the guarantees (see `docs/AGENT_API.md`).",
      "oneOf": [
        {
          "description": "Another activity/task in a shared process and shared app data. No isolation.",
          "enum": [
            "shared-task"
          ],
          "type": "string"
        },
        {
          "description": "Separate process, potentially the same package/storage identity.",
          "enum": [
            "process"
          ],
          "type": "string"
        },
        {
          "description": "Separate process/UID/credentials/mount namespace and app data.",
          "enum": [
            "sandbox"
          ],
          "type": "string"
        },
        {
          "description": "Fully separate engine instance (strongest short of a VM).",
          "enum": [
            "core"
          ],
          "type": "string"
        },
        {
          "description": "Sandboxed full Android/backend for untrusted or device-level fidelity.",
          "enum": [
            "vm"
          ],
          "type": "string"
        }
      ]
    },
    "RegionMask": {
      "description": "A rectangle excluded from screenshot comparison (clock, status bar, ...).\n\nBounds are **display pixels**, like every other rectangle in the scenario format; the executor maps them onto the frame with the frame's `display_origin`.",
      "properties": {
        "bounds": {
          "allOf": [
            {
              "$ref": "#/definitions/Bounds"
            }
          ],
          "description": "Screen region to mask out."
        },
        "reason": {
          "description": "Why this region is nondeterministic (documented, not decorative).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bounds"
      ],
      "type": "object"
    },
    "RequestBase": {
      "description": "Identity fields present on every request.",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceBudget"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hard resource budget."
        },
        "capabilities": {
          "description": "Capabilities the request needs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cause_id": {
          "description": "The cause of the last known frame, when relevant.",
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "anyOf": [
            {
              "$ref": "#/definitions/DisplaySpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested display (for `run`; reported everywhere)."
        },
        "frame_seq": {
          "description": "The last frame sequence the client has seen, when relevant.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "isolation": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationLevel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested isolation level (for `run`/`verify`; reported everywhere)."
        },
        "request_id": {
          "description": "Client-chosen request id, echoed in the envelope and used as the frame `cause_id` for actions that produce a frame.",
          "type": "string"
        },
        "session_id": {
          "description": "Session the request targets (absent for session-creating commands).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "request_id"
      ],
      "type": "object"
    },
    "ResourceBudget": {
      "description": "Hard resource budgets for one request or one scenario.\n\nEvery field is opt-in; `None` means \"use the engine default\". The engine must return `RESOURCE_LIMIT`/`TIMEOUT` when a budget is exhausted instead of silently exceeding it.",
      "properties": {
        "cpu_ms": {
          "description": "Maximum CPU time, in milliseconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_mib": {
          "description": "Maximum resident memory attributable to this request/session, in MiB.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "wall_ms": {
          "description": "Maximum wall-clock time, in milliseconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Selector": {
      "description": "A node selector. See the module docs for the stable matching rules.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/definitions/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact screen bounds."
        },
        "class": {
          "description": "Exact view class.",
          "type": [
            "string",
            "null"
          ]
        },
        "content_desc": {
          "anyOf": [
            {
              "$ref": "#/definitions/TextMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content-description matcher."
        },
        "hint": {
          "anyOf": [
            {
              "$ref": "#/definitions/TextMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hint matcher (`TextView.getHint()`, e.g. an EditText placeholder)."
        },
        "id": {
          "description": "Android resource id (`pkg:id/name`), or a bare local id (`name`).",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "description": "Zero-based occurrence among otherwise matching nodes.",
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/definitions/TextMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "Text matcher."
        }
      },
      "type": "object"
    },
    "TextMatch": {
      "description": "A text matching rule: exactly one of `exact`, `contains`, `regex`.\n\nA struct rather than an enum so the agent-facing YAML/JSON form is a plain map (`text: {exact: \"Greet\"}`) and not a YAML `!tag`.",
      "properties": {
        "contains": {
          "description": "Substring containment.",
          "type": [
            "string",
            "null"
          ]
        },
        "exact": {
          "description": "Full string equality (no trimming or normalisation).",
          "type": [
            "string",
            "null"
          ]
        },
        "regex": {
          "description": "Unanchored Rust regex (`is_match`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "`assert`: evaluate an assertion.",
  "properties": {
    "assertion": {
      "allOf": [
        {
          "$ref": "#/definitions/Assertion"
        }
      ],
      "description": "The assertion."
    },
    "base": {
      "allOf": [
        {
          "$ref": "#/definitions/RequestBase"
        }
      ],
      "description": "Identity fields."
    },
    "fresh_frame": {
      "default": false,
      "description": "Produce a fresh frame as part of the assertion evidence.",
      "type": "boolean"
    }
  },
  "required": [
    "assertion",
    "base"
  ],
  "title": "AssertRequest",
  "type": "object"
}
